# Debug version 2026-02-25 v3 - improved port handling + startup trace
FROM php:8.2-apache

# Install system packages
RUN apt-get update && apt-get install -y \
    git unzip libzip-dev \
    && docker-php-ext-install zip pdo pdo_mysql

# Enable required modules
RUN a2enmod rewrite mpm_prefork

# Install Composer
COPY --from=composer:2 /usr/bin/composer /usr/bin/composer

WORKDIR /var/www/html

# Copy project files
COPY . .

# Remove vendor for clean install
RUN rm -rf vendor

# Install dependencies (production)
RUN composer install \
    --no-dev \
    --optimize-autoloader \
    --prefer-dist \
    --no-interaction

# Set correct permissions
RUN chown -R www-data:www-data /var/www/html \
    && chmod -R 755 storage \
    && chmod -R 755 bootstrap/cache

# ────────────────────────────────────────────────
# Apache configuration fixes (done at build time)

# Suppress ServerName warning
RUN echo "ServerName localhost" >> /etc/apache2/apache2.conf

# Change document root to /public (Laravel standard)
RUN sed -i 's!/var/www/html!/var/www/html/public!g' \
    /etc/apache2/sites-available/000-default.conf

# Prepare ports.conf to be easy to override at runtime
# (we'll replace Listen line dynamically in CMD)
RUN echo "Listen 8080" > /etc/apache2/ports.conf  # temporary fallback

# Make sure VirtualHost uses *: (we override port in CMD)
RUN sed -i 's/<VirtualHost \*:80>/<VirtualHost *:${PORT:-8080}>/g' \
    /etc/apache2/sites-available/000-default.conf || true

# Expose the port Railway will use
EXPOSE ${PORT:-8080}

# ────────────────────────────────────────────────
# Startup script: trace mode + force port binding + debug
CMD set -x && \
    echo "=== CONTAINER START $(date) ===" && \
    echo "PORT from env: '${PORT}'" && \
    PORT="${PORT:-8080}" && \
    echo "Using port: $PORT" && \
    # Force update configs with correct port \
    sed -i "s/^Listen.*/Listen $PORT/" /etc/apache2/ports.conf && \
    sed -i "s/<VirtualHost \*:.*>/<VirtualHost *:$PORT>/" /etc/apache2/sites-available/000-default.conf && \
    echo "ports.conf Listen line:" && grep Listen /etc/apache2/ports.conf || echo "Listen not found!" && \
    echo "vhost VirtualHost line:" && grep VirtualHost /etc/apache2/sites-available/000-default.conf || echo "VirtualHost not found!" && \
    # Final config check \
    apache2ctl configtest && echo "Apache config OK" || { echo "Apache config FAILED"; exit 1; } && \
    # Quick Laravel/PHP checks (non-fatal) \
    echo "PHP version:" && php -v && \
    php artisan --version 2>&1 || echo "Artisan failed - check APP_KEY or vendor/autoload.php" && \
    echo "=== STARTING APACHE on port $PORT ===" && \
    exec apache2-foreground