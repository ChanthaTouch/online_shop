# -------------------------------
#  Build stage for Composer + assets
# -------------------------------
FROM php:8.2-apache AS builder

# Install system dependencies
RUN apt-get update && apt-get install -y \
    git unzip libzip-dev curl libpng-dev libjpeg-dev libfreetype6-dev \
    && docker-php-ext-configure gd --with-freetype --with-jpeg \
    && docker-php-ext-install zip pdo pdo_mysql gd \
    && rm -rf /var/lib/apt/lists/*

# Install Node.js 20 + pnpm
RUN curl -fsSL https://deb.nodesource.com/setup_20.x | bash - \
    && apt-get install -y nodejs \
    && npm install -g pnpm@latest

# Enable Apache modules
RUN a2enmod rewrite headers

# Prefer prefork MPM (required for mod_php in Apache)
RUN a2dismod mpm_event mpm_worker || true \
    && a2enmod mpm_prefork || true

# Composer
COPY --from=composer:2 /usr/bin/composer /usr/bin/composer

WORKDIR /var/www/html

# Copy dependency files first → great caching
COPY composer.json composer.lock* ./

RUN composer install --no-dev --optimize-autoloader --prefer-dist --no-interaction --no-scripts

# Copy full backend source
COPY . .

# Copy frontend dependency files (for caching)
WORKDIR /var/www/html/frontend
COPY frontend/package.json frontend/pnpm-lock.yaml* ./

RUN pnpm install || pnpm install --no-frozen-lockfile

# Copy frontend source and build
COPY frontend/ .
RUN pnpm run build

# Copy built Vue assets to Laravel public
WORKDIR /var/www/html
RUN cp -r frontend/dist/* public/ \
    && cp -r frontend/dist/.* public/ 2>/dev/null || true

# Final permissions (will be reinforced at runtime too)
RUN chown -R www-data:www-data /var/www/html \
    && chmod -R 755 /var/www/html \
    && find /var/www/html/storage /var/www/html/bootstrap/cache -type f -exec chmod 664 {} \; \
    && find /var/www/html/storage /var/www/html/bootstrap/cache -type d -exec chmod 775 {} \;

# -------------------------------
#  Final runtime image
# -------------------------------
FROM php:8.2-apache

# Copy only what's needed from builder
COPY --from=builder /var/www/html /var/www/html
COPY --from=builder /usr/bin/composer /usr/bin/composer

# Install runtime dependencies only
RUN apt-get update && apt-get install -y \
    libzip-dev libpng-dev libjpeg-dev libfreetype6-dev \
    && docker-php-ext-configure gd --with-freetype --with-jpeg \
    && docker-php-ext-install zip pdo pdo_mysql gd \
    && rm -rf /var/lib/apt/lists/*

# Apache modules
RUN a2enmod rewrite headers mpm_prefork \
    && a2dismod mpm_event mpm_worker || true

# Custom vhost for SPA + Laravel API
RUN rm -f /etc/apache2/sites-enabled/000-default.conf

RUN echo "<VirtualHost *:${PORT:-8080}>\n\
    ServerName localhost\n\
    DocumentRoot /var/www/html/public\n\
    <Directory /var/www/html/public>\n\
        Options +FollowSymLinks -Indexes\n\
        AllowOverride All\n\
        Require all granted\n\
        RewriteEngine On\n\
        RewriteCond %{REQUEST_FILENAME} !-f\n\
        RewriteCond %{REQUEST_FILENAME} !-d\n\
        RewriteRule ^ index.html [L]\n\
    </Directory>\n\
    ErrorLog \${APACHE_LOG_DIR}/error.log\n\
    CustomLog \${APACHE_LOG_DIR}/access.log combined\n\
</VirtualHost>" > /etc/apache2/sites-available/laravel.conf

RUN a2ensite laravel.conf

# Use dynamic port from Railway
RUN echo "Listen ${PORT:-8080}" > /etc/apache2/ports.conf

# Copy entrypoint
COPY entrypoint.sh /usr/local/bin/entrypoint.sh
RUN chmod +x /usr/local/bin/entrypoint.sh

WORKDIR /var/www/html

EXPOSE ${PORT:-8080}

# Use entrypoint instead of CMD → better control over startup sequence
ENTRYPOINT ["/usr/local/bin/entrypoint.sh"]