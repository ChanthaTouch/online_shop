# Debug version 2026-02-25 v5 - explicit vhost + Directory permissions fix
FROM php:8.2-apache

# Install system packages
RUN apt-get update && apt-get install -y \
    git unzip libzip-dev \
    && docker-php-ext-install zip pdo pdo_mysql

# Enable required modules
RUN a2enmod rewrite mpm_prefork headers

# Install Composer
COPY --from=composer:2 /usr/bin/composer /usr/bin/composer

WORKDIR /var/www/html

# Copy project files
COPY . .

# Remove vendor for clean install
RUN rm -rf vendor

# Install dependencies (production)
RUN composer install \
    --no-dev \
    --optimize-autoloader \
    --prefer-dist \
    --no-interaction

# Permissions - make sure public is readable/executable
RUN chown -R www-data:www-data /var/www/html \
    && chmod -R 755 /var/www/html \
    && find /var/www/html/public -type f -exec chmod 644 {} \; \
    && find /var/www/html/public -type d -exec chmod 755 {} \;

# ────────────────────────────────────────────────
# Custom vhost config - explicit & reliable

RUN rm -f /etc/apache2/sites-enabled/* \
    && rm -f /etc/apache2/sites-available/000-default.conf

# Create proper Laravel vhost
RUN echo '\
<VirtualHost *:${PORT:-8080}>\n\
    ServerName localhost\n\
    ServerAdmin webmaster@localhost\n\
    DocumentRoot /var/www/html/public\n\
\n\
    <Directory /var/www/html/public>\n\
        Options Indexes FollowSymLinks\n\
        AllowOverride All\n\
        Require all granted\n\
    </Directory>\n\
\n\
    ErrorLog ${APACHE_LOG_DIR}/error.log\n\
    CustomLog ${APACHE_LOG_DIR}/access.log combined\n\
</VirtualHost>' > /etc/apache2/sites-available/laravel.conf

# Enable it
RUN a2ensite laravel.conf

# Suppress ServerName warning
RUN echo "ServerName localhost" >> /etc/apache2/apache2.conf

# Ports fallback
RUN echo "Listen 8080" > /etc/apache2/ports.conf

# Expose dynamic port
EXPOSE ${PORT:-8080}

# ────────────────────────────────────────────────
# Startup debug
CMD set -x && \
    echo "=== START $(date) ===" && \
    echo "PORT env: '${PORT}'" && \
    PORT="${PORT:-8080}" && \
    echo "Bind port: $PORT" && \
    sed -i "s/<VirtualHost \*:.*>/<VirtualHost *:$PORT>/" /etc/apache2/sites-available/laravel.conf && \
    sed -i "s/Listen .*/Listen $PORT/" /etc/apache2/ports.conf && \
    grep -E "Listen|VirtualHost|DocumentRoot|AllowOverride|Require" /etc/apache2/sites-available/laravel.conf && \
    apache2ctl configtest && echo "Config OK" || { echo "Config FAILED"; exit 1; } && \
    echo "PHP:" && php -v && \
    php artisan --version 2>&1 || echo "Artisan FAILED (check APP_KEY)" && \
    echo "=== APACHE START ===" && \
    exec apache2-foreground