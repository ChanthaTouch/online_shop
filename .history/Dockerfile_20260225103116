FROM php:8.2-apache

# Install system packages
RUN apt-get update && apt-get install -y \
    git unzip libzip-dev \
    && docker-php-ext-install zip pdo pdo_mysql

# Enable rewrite module
RUN a2enmod rewrite

# Install Composer
COPY --from=composer:2 /usr/bin/composer /usr/bin/composer

WORKDIR /var/www/html

# Copy project files
COPY . .

# Remove vendor for clean install
RUN rm -rf vendor

# Install dependencies (production)
RUN composer install \
    --no-dev \
    --optimize-autoloader \
    --prefer-dist \
    --no-interaction

# Set correct permissions
RUN chown -R www-data:www-data /var/www/html \
    && chmod -R 755 storage \
    && chmod -R 755 bootstrap/cache

# Set Laravel public folder as document root
RUN sed -i 's!/var/www/html!/var/www/html/public!g' /etc/apache2/sites-available/000-default.conf

# Suppress ServerName warning
RUN echo "ServerName localhost" >> /etc/apache2/apache2.conf

# Expose port (Railway handles mapping)
EXPOSE 80

# Clean + silent startup + auto-run migrations
CMD ["bash", "-c", "set -euo pipefail && \
    # Silent MPM fix (removes all the spam in logs)
    a2dismod mpm_event mpm_worker >/dev/null 2>&1 || true && \
    rm -f /etc/apache2/mods-enabled/mpm_event.* /etc/apache2/mods-enabled/mpm_worker.* >/dev/null 2>&1 || true && \
    a2enmod mpm_prefork >/dev/null 2>&1 && \
    # Dynamic Railway $PORT support
    PORT=${PORT:-80} && \
    sed -i \"s/Listen 80/Listen $PORT/g\" /etc/apache2/ports.conf && \
    sed -i \"s/<VirtualHost \\*:80>/<VirtualHost *:$PORT>/g\" /etc/apache2/sites-available/000-default.conf && \
    # Laravel: run migrations automatically (safe on every deploy)
    php artisan migrate --force --no-interaction && \
    # Validate config & start Apache
    apache2ctl configtest && \
    exec apache2-foreground"]