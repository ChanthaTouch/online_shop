# Debug version 2026-02-25 v2 - verbose startup, migrate disabled temporarily
FROM php:8.2-apache

# Install system packages
RUN apt-get update && apt-get install -y \
    git unzip libzip-dev \
    && docker-php-ext-install zip pdo pdo_mysql

# Enable rewrite module
RUN a2enmod rewrite

# Install Composer
COPY --from=composer:2 /usr/bin/composer /usr/bin/composer

WORKDIR /var/www/html

# Copy project files
COPY . .

# Remove vendor for clean install
RUN rm -rf vendor

# Install dependencies (production)
RUN composer install \
    --no-dev \
    --optimize-autoloader \
    --prefer-dist \
    --no-interaction

# Set correct permissions
RUN chown -R www-data:www-data /var/www/html \
    && chmod -R 755 storage \
    && chmod -R 755 bootstrap/cache

# Set Laravel public folder as document root
RUN sed -i 's!/var/www/html!/var/www/html/public!g' /etc/apache2/sites-available/000-default.conf

# Suppress ServerName warning
RUN echo "ServerName localhost" >> /etc/apache2/apache2.conf

# Expose port (Railway handles mapping)
EXPOSE ${PORT:-8080}

CMD ["bash", "-c", "\
    set -x && \
    echo '=== CONTAINER START DEBUG ===' && \
    echo \"RAILWAY assigned PORT: '${PORT}' (fallback 8080)\" && \
    PORT=\"${PORT:-8080}\" && \
    echo \"Using port: $PORT\" && \
    echo 'Current ports.conf content:' && cat /etc/apache2/ports.conf || echo 'ports.conf missing!' && \
    echo 'Current 000-default.conf VirtualHost line:' && \
        grep -i VirtualHost /etc/apache2/sites-available/000-default.conf || echo 'No VirtualHost found' && \
    echo 'MPM modules enabled:' && ls -l /etc/apache2/mods-enabled/ | grep mpm || echo 'No MPM loaded?' && \
    a2enmod rewrite mpm_prefork 2>&1 && \
    echo 'Apache modules check done' && \
    apache2ctl configtest 2>&1 && echo 'Config OK' || { echo 'CONFIG TEST FAILED'; exit 1; } && \
    echo 'PHP version:' && php -v && \
    echo 'Artisan check:' && php artisan --version 2>&1 || echo 'ARTISAN FAILED - likely APP_KEY or autoload issue' && \
    echo '=== STARTING APACHE NOW ===' && \
    exec apache2-foreground \
"