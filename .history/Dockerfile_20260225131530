# -------------------------------------------------
# Base Image
# -------------------------------------------------
FROM php:8.2-apache

# -------------------------------------------------
# Install system dependencies
# -------------------------------------------------
RUN apt-get update && apt-get install -y \
    git \
    unzip \
    libzip-dev \
    && docker-php-ext-install zip pdo pdo_mysql \
    && rm -rf /var/lib/apt/lists/*

# -------------------------------------------------
# FIX: Prevent "More than one MPM loaded"
# -------------------------------------------------
RUN a2dismod mpm_event mpm_worker || true
RUN a2enmod mpm_prefork

# Enable required Apache modules
RUN a2enmod rewrite headers

# -------------------------------------------------
# Install Composer
# -------------------------------------------------
COPY --from=composer:2 /usr/bin/composer /usr/bin/composer

# -------------------------------------------------
# Set working directory
# -------------------------------------------------
WORKDIR /var/www/html

# -------------------------------------------------
# Copy project files
# -------------------------------------------------
COPY . .

# -------------------------------------------------
# Install Laravel dependencies
# -------------------------------------------------
RUN rm -rf vendor \
    && composer install \
        --no-dev \
        --optimize-autoloader \
        --prefer-dist \
        --no-interaction

# -------------------------------------------------
# Set proper permissions
# -------------------------------------------------
RUN chown -R www-data:www-data /var/www/html \
    && chmod -R 755 /var/www/html \
    && chmod -R 775 /var/www/html/storage \
    && chmod -R 775 /var/www/html/bootstrap/cache

# -------------------------------------------------
# Configure Apache for Laravel
# -------------------------------------------------
RUN rm -f /etc/apache2/sites-enabled/000-default.conf

RUN echo '\
<VirtualHost *:8080>\n\
    ServerName localhost\n\
    DocumentRoot /var/www/html/public\n\
\n\
    <Directory /var/www/html/public>\n\
        Options +FollowSymLinks -Indexes\n\
        AllowOverride All\n\
        Require all granted\n\
    </Directory>\n\
\n\
    ErrorLog ${APACHE_LOG_DIR}/error.log\n\
    CustomLog ${APACHE_LOG_DIR}/access.log combined\n\
</VirtualHost>' > /etc/apache2/sites-available/laravel.conf

RUN a2ensite laravel.conf

# Suppress ServerName warning
RUN echo "ServerName localhost" >> /etc/apache2/apache2.conf

# Railway uses dynamic PORT
ENV PORT=8080
EXPOSE 8080

# -------------------------------------------------
# Start Apache (Railway compatible)
# -------------------------------------------------
CMD sed -i "s/Listen .*/Listen ${PORT}/" /etc/apache2/ports.conf && \
    sed -i "s/<VirtualHost \*:8080>/<VirtualHost *:${PORT}>/" /etc/apache2/sites-available/laravel.conf && \
    apache2ctl configtest && \
    exec apache2-foreground
