FROM php:8.2-apache

# Install system packages
RUN apt-get update && apt-get install -y \
    git unzip libzip-dev \
    && docker-php-ext-install zip pdo pdo_mysql

# Enable rewrite module
RUN a2enmod rewrite

# Install Composer
COPY --from=composer:2 /usr/bin/composer /usr/bin/composer

WORKDIR /var/www/html

# Copy project files
COPY . .

# Remove vendor for clean install
RUN rm -rf vendor

# Install dependencies (production)
RUN composer install \
    --no-dev \
    --optimize-autoloader \
    --prefer-dist \
    --no-interaction

# Set correct permissions
RUN chown -R www-data:www-data /var/www/html \
    && chmod -R 755 storage \
    && chmod -R 755 bootstrap/cache

# Set Laravel public folder as document root
RUN sed -i 's!/var/www/html!/var/www/html/public!g' /etc/apache2/sites-available/000-default.conf

# Suppress ServerName warning
RUN echo "ServerName localhost" >> /etc/apache2/apache2.conf

# Expose port (Railway handles mapping)
EXPOSE 80

# Clean + silent startup + auto-run migrations
CMD ["bash", "-c", "set -euo pipefail && \
    echo '=== Starting container ===' && \
    # MPM fix (keep silent) \
    a2dismod mpm_event mpm_worker >/dev/null 2>&1 || true && \
    rm -f /etc/apache2/mods-enabled/mpm_event.* /etc/apache2/mods-enabled/mpm_worker.* >/dev/null 2>&1 || true && \
    a2enmod mpm_prefork >/dev/null 2>&1 && \
    echo 'MPM prefork activated' && \
    # Dynamic port \
    PORT=${PORT:-80} && \
    echo \"Using port: $PORT\" && \
    sed -i \"s/Listen 80/Listen $PORT/g\" /etc/apache2/ports.conf && \
    sed -i \"s/<VirtualHost \\*:80>/<VirtualHost *:$PORT>/g\" /etc/apache2/sites-available/000-default.conf && \
    apache2ctl configtest && echo 'Apache config OK' || { echo 'Apache config FAILED'; exit 1; } && \
    # Laravel bootstrap checks \
    echo 'Checking APP_KEY...' && \
    php artisan --version || { echo 'Laravel artisan FAILED – check APP_KEY or composer autoload'; exit 1; } && \
    echo 'Checking DB connection...' && \
    php artisan db:monitor --once || echo 'DB connection check failed (will continue anyway)' && \
    # Try migrate, but DON'T crash container if it fails \
    echo 'Running migrations (non-blocking)...' && \
    php artisan migrate --force --no-interaction || echo 'Migrations failed or skipped – continuing...' && \
    echo '=== Starting Apache ===' && \
    exec apache2-foreground"]