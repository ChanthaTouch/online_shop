# Debug version 2026-02-25 v6 – explicit vhost + strong Directory permissions
FROM php:8.2-apache

# Install system packages
RUN apt-get update && apt-get install -y \
    git unzip libzip-dev \
    && docker-php-ext-install zip pdo pdo_mysql

# Enable essential modules
RUN a2enmod rewrite mpm_prefork headers

# Install Composer
COPY --from=composer:2 /usr/bin/composer /usr/bin/composer

WORKDIR /var/www/html

# Copy project files
COPY . .

# Remove vendor for clean install
RUN rm -rf vendor

# Install dependencies (production)
RUN composer install \
    --no-dev \
    --optimize-autoloader \
    --prefer-dist \
    --no-interaction
RUN a2dismod mpm_event || true
# Permissions – very important for Apache to read/execute
RUN chown -R www-data:www-data /var/www/html \
    && chmod -R 755 /var/www/html \
    && chmod -R 755 /var/www/html/public \
    && chmod -R 644 /var/www/html/public/*.php \
    && chmod -R 755 /var/www/html/public/index.php

# ────────────────────────────────────────────────
# Clean custom vhost – no sed hacks, explicit permissions

RUN rm -f /etc/apache2/sites-enabled/* \
    && rm -f /etc/apache2/sites-available/000-default.conf

RUN echo '\
<VirtualHost *:${PORT:-8080}>\n\
    ServerName localhost\n\
    ServerAdmin webmaster@localhost\n\
    DocumentRoot /var/www/html/public\n\
\n\
    <Directory /var/www/html/public>\n\
        Options +FollowSymLinks -Indexes\n\
        AllowOverride All\n\
        Require all granted\n\
    </Directory>\n\
\n\
    <Directory />\n\
        Require all denied\n\
    </Directory>\n\
\n\
    ErrorLog ${APACHE_LOG_DIR}/error.log\n\
    CustomLog ${APACHE_LOG_DIR}/access.log combined\n\
</VirtualHost>' > /etc/apache2/sites-available/laravel.conf

# Enable the new site
RUN a2ensite laravel.conf

# Suppress ServerName warning
RUN echo "ServerName localhost" >> /etc/apache2/apache2.conf

# Fallback port
RUN echo "Listen 8080" > /etc/apache2/ports.conf

EXPOSE ${PORT:-8080}

# ────────────────────────────────────────────────
# Startup debug
CMD set -x && \
    echo "=== CONTAINER START $(date) ===" && \
    echo "PORT env: '${PORT}'" && \
    PORT="${PORT:-8080}" && \
    echo "Using port: $PORT" && \
    sed -i "s/<VirtualHost \*:.*>/<VirtualHost *:$PORT>/" /etc/apache2/sites-available/laravel.conf && \
    sed -i "s/Listen .*/Listen $PORT/" /etc/apache2/ports.conf && \
    echo "Active vhost config:" && cat /etc/apache2/sites-available/laravel.conf && \
    apache2ctl configtest && echo "Config OK" || { echo "Config FAILED"; exit 1; } && \
    echo "PHP:" && php -v && \
    php artisan --version 2>&1 || echo "Artisan FAILED - check APP_KEY" && \
    echo "=== START APACHE ===" && \
    exec apache2-foreground