# Debug version 2026-02-25 v2 - verbose startup, migrate disabled temporarily
FROM php:8.2-apache

# Install system packages
RUN apt-get update && apt-get install -y \
    git unzip libzip-dev \
    && docker-php-ext-install zip pdo pdo_mysql

# Enable rewrite module
RUN a2enmod rewrite

# Install Composer
COPY --from=composer:2 /usr/bin/composer /usr/bin/composer

WORKDIR /var/www/html

# Copy project files
COPY . .

# Remove vendor for clean install
RUN rm -rf vendor

# Install dependencies (production)
RUN composer install \
    --no-dev \
    --optimize-autoloader \
    --prefer-dist \
    --no-interaction

# Set correct permissions
RUN chown -R www-data:www-data /var/www/html \
    && chmod -R 755 storage \
    && chmod -R 755 bootstrap/cache

# Set Laravel public folder as document root
RUN sed -i 's!/var/www/html!/var/www/html/public!g' /etc/apache2/sites-available/000-default.conf

# Suppress ServerName warning
RUN echo "ServerName localhost" >> /etc/apache2/apache2.conf

# Expose port (Railway handles mapping)
EXPOSE ${PORT:-8080}

# Verbose startup – migrate disabled for now to isolate issues
CMD ["bash", "-c", "\
    echo '=== DEBUG START: Container starting at $(date) ===' && \
    echo 'RAILWAY PORT env var is: ${PORT}' && \
    echo 'Fallback to 8080 if unset' && \
    export PORT=${PORT:-8080} && \
    echo \"Final port to bind: $PORT\" && \
    # Apply port changes (more robust patterns) \
    sed -i \"s/Listen .*/Listen $PORT/\" /etc/apache2/ports.conf || echo 'ports.conf sed failed' && \
    sed -i \"s/<VirtualHost \\*:[0-9]*>/<VirtualHost *:$PORT>/\" /etc/apache2/sites-available/000-default.conf || echo 'vhost sed failed' && \
    sed -i 's/Listen 80/Listen '"$PORT"'/g' /etc/apache2/ports.conf || true && \
    cat /etc/apache2/ports.conf | grep Listen && \
    cat /etc/apache2/sites-available/000-default.conf | grep VirtualHost && \
    # MPM fix (silent) \
    a2dismod mpm_event mpm_worker >/dev/null 2>&1 || true && \
    rm -f /etc/apache2/mods-enabled/mpm_event.* >/dev/null 2>&1 || true && \
    a2enmod mpm_prefork >/dev/null 2>&1 && \
    echo 'MPM prefork should be active' && \
    # Test config \
    apache2ctl configtest && echo 'Config test PASSED' || { echo 'Config test FAILED - aborting'; cat /etc/apache2/apache2.conf; exit 1; } && \
    # Quick Laravel check (non-fatal) \
    echo 'Laravel quick check...' && \
    php -v && \
    php artisan --version 2>&1 || echo 'Artisan failed - check APP_KEY or vendor/autoload.php' && \
    # Start Apache in foreground \
    echo '=== Starting apache2-foreground on port $PORT ===' && \
    exec apache2-foreground \
"]